# CargoVision AI — Master Environment Configuration Template
# Copy this file to .env for local overrides. Do NOT commit secrets to Git.

# -------------------------------------------------------------
# Server Network Settings
# -------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
ENV=development

# -------------------------------------------------------------
# Security & Cross-Origin Resource Sharing (CORS)
# -------------------------------------------------------------
# Comma-separated list of allowed frontend origins:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# -------------------------------------------------------------
# Storage & Database Paths (Defaults to local workspace paths)
# -------------------------------------------------------------
# DATABASE_PATH=/custom/path/to/inspections.db
# UPLOAD_DIR=/custom/path/to/uploads
# MODEL_DIR=/custom/path/to/models

# -------------------------------------------------------------
# Public Demo Quotas & Resource Controls
# -------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=35
MAX_CONCURRENT_JOBS=1

# -------------------------------------------------------------
# Optional Integrations
# -------------------------------------------------------------
# GROQ_API_KEY=your_groq_api_key_here
