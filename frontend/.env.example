# CargoVision AI - Frontend Environment Configuration Template
# Copy this file to .env or .env.production as needed.
# Note: Variables starting with VITE_ are exposed to the client bundle. Never store secrets here.

# Backend API Base URL
# Local Development:
VITE_API_BASE_URL=http://localhost:8000

# Public Production Example (replace with your actual hosted backend URL):
# VITE_API_BASE_URL=https://cargovision-ai-backend.hf.space
# VITE_API_BASE_URL=https://cargovision-api.onrender.com
